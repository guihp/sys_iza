# Worker de despacho de lembretes. Roda o laço de 5 minutos fora do Next.
#
# O build gera um bundle único com esbuild (`pnpm worker:build` -> dist/worker.cjs,
# com @supabase/supabase-js e zod embutidos). Por isso a imagem final não leva
# node_modules nem o pnpm: é o node e um arquivo.

FROM node:22-alpine AS build
RUN corepack enable
WORKDIR /app
COPY app/package.json app/pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile
COPY app/ .
RUN pnpm worker:build

FROM node:22-alpine AS run
ENV NODE_ENV=production
WORKDIR /app
COPY --from=build /app/dist/worker.cjs ./worker.cjs

# O worker não abre porta e não precisa de privilégio nenhum.
USER node

# Sem shell no meio: o node recebe o SIGTERM do Coolify direto e faz o
# encerramento limpo (espera o ciclo em andamento terminar antes de sair).
CMD ["node", "worker.cjs"]
