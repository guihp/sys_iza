# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Evolution API (rede interna da VPS)
EVOLUTION_URL=http://evolution:8080
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=
# E-mail
RESEND_API_KEY=
EMAIL_FROM=
# Aplicação
APP_TZ=America/Sao_Paulo

# Meta CAPI + Marketing API — opcionais (sem elas o recurso fica desligado)
META_DATASET_ID=
META_CAPI_TOKEN=
META_ADS_TOKEN=
META_AD_ACCOUNT_ID=
META_GRAPH_API_VERSION=v25.0
META_WHATSAPP_BUSINESS_ACCOUNT_ID=
META_TEST_EVENT_CODE=

# Google Agenda — opcional; as três juntas ligam a sincronia
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_CALENDAR_ID=

# Web Push (PWA) — opcional; sem as três o aviso de agendamento fica desligado
# Gere o par: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:dono@clinicaizadora.com.br

# API HTTP (n8n / automação) — opcional; sem ela só cookie de sessão autentica
# Gere: openssl rand -hex 32
# Preferir API_KEY. AGENDA_API_KEY é alias legado (mesmo uso).
# Auth: Authorization: Bearer … ou x-api-key
API_KEY=
AGENDA_API_KEY=
